{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "FoodDelivery.Api",
    "Audience": "FoodDelivery.Client",
    "AccessTokenLifetimeMinutes": 120,
    "RefreshTokenLifetimeDays": 14
  }
}
